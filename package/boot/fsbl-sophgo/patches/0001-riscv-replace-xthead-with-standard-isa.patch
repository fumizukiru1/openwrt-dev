From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hermes Agent <hermes@nousresearch.com>
Date: Mon, 2 Nov 2026 00:00:00 +0800
Subject: [PATCH] riscv: replace T-Head xthead instructions/CSRs with standard equivalents

The C906 (RV64GC) uses T-Head custom cache/status instructions (icache.iall,
sync.i) and CSRs (mxstatus/mhcr/mcor/mhint) that upstream gcc/llvm do not
assemble. Replace them with the standard fence.i instruction and raw CSR
numbers, and drop the xthead extension from -march (adding zicsr/zifencei
which gcc 13+ split out of the base I extension).

---
diff --git a/lib/cpu/riscv/bl1_entrypoint.S b/lib/cpu/riscv/bl1_entrypoint.S
index dd85be9..584549a 100644
--- a/lib/cpu/riscv/bl1_entrypoint.S
+++ b/lib/cpu/riscv/bl1_entrypoint.S
@@ -65,9 +65,9 @@ bl1_entrypoint_rel:
   la t0, trap_vector
   csrw mtvec, t0
 
-  # set mxstatus to init value
+  # set 0x7c0 to init value
   li x3, 0xc0638000
-  csrw mxstatus, x3
+  csrw 0x7c0, x3
 
   # set plic_ctrl = 1 for linux plic
   li x3, 0x701FFFFC # plic_base + 0x1FFFFC
@@ -76,13 +76,13 @@ bl1_entrypoint_rel:
 
   // invalidate all memory for BTB,BHT,DCACHE,ICACHE
   li x3, 0x30013
-  csrs mcor, x3
+  csrs 0x7c2, x3
   // enable ICACHE,DCACHE,BHT,BTB,RAS,WA
   li x3, 0x7f
-  csrs mhcr, x3
+  csrs 0x7c1, x3
   // enable data_cache_prefetch, amr
   li x3, 0x610c
-  csrs mhint, x3 #mhint
+  csrs 0x7c5, x3 #0x7c5
 
   # enable fp
   li x3, 0x1 << 13
diff --git a/lib/cpu/riscv/bl2_entrypoint.S b/lib/cpu/riscv/bl2_entrypoint.S
index 7344387..5fb30b1 100644
--- a/lib/cpu/riscv/bl2_entrypoint.S
+++ b/lib/cpu/riscv/bl2_entrypoint.S
@@ -55,9 +55,9 @@ bl2_entrypoint_real:
   la t0, trap_vector
   csrw mtvec, t0
 
-  # set mxstatus to init value
+  # set 0x7c0 to init value
   li x3, 0xc0638000
-  csrw mxstatus, x3
+  csrw 0x7c0, x3
 
   # set plic_ctrl = 1
   li x3, 0x701FFFFC # plic_base + 0x1FFFFC
@@ -66,20 +66,20 @@ bl2_entrypoint_real:
 
   # invalid I-cache
   li x3, 0x33
-  csrc mcor, x3
+  csrc 0x7c2, x3
   li x3, 0x11
-  csrs mcor, x3
+  csrs 0x7c2, x3
   # enable I-cache
   li x3, 0x1
-  csrs mhcr, x3
+  csrs 0x7c1, x3
   # invalid D-cache
   li x3, 0x33
-  csrc mcor, x3
+  csrc 0x7c2, x3
   li x3, 0x12
-  csrs mcor, x3
+  csrs 0x7c2, x3
   # enable D-cache
   li x3, 0x2
-  csrs mhcr, x3
+  csrs 0x7c1, x3
 
   la sp, __STACKS_END__
 
diff --git a/lib/cpu/riscv/cache.c b/lib/cpu/riscv/cache.c
index 54828f8..a03784b 100644
--- a/lib/cpu/riscv/cache.c
+++ b/lib/cpu/riscv/cache.c
@@ -57,14 +57,14 @@ void flush_dcache_range(uintptr_t start, size_t size)
 void enable_dcache(void)
 {
 	asm volatile(
-		"csrs mhcr, %0;" ::"rI"(0x2)
+		"csrsi 0x7c1, 2"
 	);
 }
 
 void disable_dcache(void)
 {
 	asm volatile(
-		"csrc mhcr, %0;" ::"rI"(0x2)
+		"csrci 0x7c1, 2"
 	);
 }
 
diff --git a/lib/cpu/riscv/cpu.mk b/lib/cpu/riscv/cpu.mk
index bffa5f8..8c050f3 100644
--- a/lib/cpu/riscv/cpu.mk
+++ b/lib/cpu/riscv/cpu.mk
@@ -4,7 +4,7 @@ ASFLAGS +=\
 	$(CPPFLAGS) \
 	-DRISCV \
 	-D__ASSEMBLY__ \
-	-march=rv64imafdcvxthead -mstrict-align \
+	-march=rv64imafdc_zicsr_zifencei -mstrict-align \
 	-mcmodel=medany \
 	-mabi=lp64d \
 	-ffreestanding  \
@@ -13,7 +13,7 @@ ASFLAGS +=\
 TF_CFLAGS += \
 	$(CPPFLAGS) \
 	-DRISCV \
-	-march=rv64imafdcvxthead \
+	-march=rv64imafdc_zicsr_zifencei \
 	-mcmodel=medany \
 	-mabi=lp64d \
 	-ffreestanding -fno-builtin -Wall -std=gnu99 \
diff --git a/lib/cpu/riscv/cpu_helper.c b/lib/cpu/riscv/cpu_helper.c
index 7e093fa..975bc07 100644
--- a/lib/cpu/riscv/cpu_helper.c
+++ b/lib/cpu/riscv/cpu_helper.c
@@ -11,8 +11,7 @@
 void sync_cache(void)
 {
 	asm volatile(
-			"icache.iall\n"
-			"sync.i\n"
+			"fence.i"
 			:
 			:
 			: "memory");
